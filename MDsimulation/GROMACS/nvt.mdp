define                  = -DPOSRES ; Restrain protein to prevent unfolding
integrator              = md
nsteps                  = 50000    ; 100 ps
dt                      = 0.002
continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds
cutoff-scheme           = Verlet
nstlist                 = 20
vdwtype                 = Cut-off
rvdw                    = 1.0
coulombtype             = PME
rcoulomb                = 1.0
tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1     0.1
ref_t                   = 300     300
pcoupl                  = no       ; NO PRESSURE COUPLING (Constant Volume)
gen_vel                 = yes      ; Generate velocities here!
gen_temp                = 300
